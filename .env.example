# Server-side only. Never commit a real .env.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
FAL_KEY=REPLACE_ME
# Optional
# PORT=8787
# DATA_DIR=./data
# RUN_BUDGET_USD=2
# Audio steps (text → speech, speech → text): Google AI Studio key
GEMINI_API_KEY=
# Code-drawn steps and claude-cli/… models run through the local `claude` CLI (your
# Claude subscription, no API key). Optional overrides:
# CLAUDE_BIN=claude
# CLAUDE_CLI_EFFORT=low
# local/… models (text → text only) run on this laptop via the Omarchy Local AI gateway.
# Its port can change between starts; the key is read from ~/.local/state/omarchy/local-ai/gateway.key.
# LOCAL_AI_BASE_URL=http://127.0.0.1:12434/v1
